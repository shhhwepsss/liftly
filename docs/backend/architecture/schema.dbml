// Liftly — Backend Database Schema
// Format: DBML (https://dbml.dbdiagram.io)
//
// Source-of-truth contract:
//   - Until MVP (deployed app + first Android GitHub release), this file is
//     hand-written and IS the spec. Drizzle TS schemas (src/**/*.schema.ts)
//     are implemented to match it. CI runs drizzle-dbml-generator against
//     the current Drizzle code and fails the build if the output is not
//     semantically equivalent to this file. Edit this file first when the
//     spec needs to change; CI then catches the Drizzle drift.
//   - From MVP onward, the assertion inverts: this file becomes generated
//     from src/**/*.schema.ts and must be regenerated and committed with
//     every schema PR. See docs/backend/architecture/persistence.md for
//     the full contract.
//
// Last updated: 2026-05-20
//
// Conventions:
//   - All timestamps stored as `timestamptz` (UTC); column names suffixed `_utc`
//     where the source table list calls them out explicitly.
//   - All weights stored as `decimal(6,2)` kg.
//   - All primary keys are UUID v4. Sets, Workouts, and Weigh-ins are
//     client-generated to keep offline writes idempotent.
//   - `idempotency_key` columns are separate from the PK so the same logical
//     write can be retried with the same key even if the PK is regenerated.

Project liftly {
  database_type: 'PostgreSQL'
  Note: '''
    Modular monolith schema for the Liftly MVP. See
    docs/backend/architecture/bounded-contexts.md for module ownership and
    docs/backend/architecture/domain-logic.md for domain logic placement
    and the rationale behind index choices.
  '''
}

// ─── Enums ────────────────────────────────────────────────────────────────

Enum display_unit {
  kg
  lb
}

Enum theme {
  system
  light
  dark
}

Enum trigger_rule_variant {
  first_set_upper_bound
  last_set_upper_bound
}

Enum progression_direction {
  up
  down
}

Enum notification_kind {
  progression
  reminder
  achievement
}

// ─── Identity & Settings ──────────────────────────────────────────────────

Table users {
  id uuid [pk]
  google_id varchar [not null, unique]
  display_unit display_unit [not null, default: 'kg']
  locale varchar [not null]
  theme theme [not null, default: 'system']
  default_rep_range_lower int [not null]
  default_rep_range_upper int [not null]
  default_increment_kg decimal(5,2) [not null]
  default_trigger_rule trigger_rule_variant [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Soft-delete: none. Account deletion is out of scope at MVP (PRD §8).'
}

// ─── Exercise Catalog ─────────────────────────────────────────────────────

Table exercises {
  id uuid [pk]
  name varchar [not null]
  primary_muscle_group varchar [not null]
  equipment varchar [not null]
  is_preset boolean [not null, default: false]

  Indexes {
    name [unique, name: 'exercises_name_preset_uq', note: 'Partial unique index: WHERE is_preset = true']
  }
}

Table custom_exercises {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  name varchar [not null]
  primary_muscle_group varchar [not null]
  equipment varchar [not null]

  Indexes {
    user_id
  }

  Note: '''
    See docs/backend/open-questions.md Q1: this may be merged
    into `exercises` with a nullable `user_id` and the `is_preset` flag.
  '''
}

// ─── Routines ─────────────────────────────────────────────────────────────

Table routines {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  name varchar [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id
  }
}

Table routine_exercises {
  id uuid [pk]
  routine_id uuid [not null, ref: > routines.id]
  exercise_id uuid [not null, note: 'Polymorphic FK → exercises OR custom_exercises (see open-questions.md Q1)']
  position int [not null]
  rest_seconds int [not null]

  Indexes {
    (routine_id, position)
  }
}

Table user_exercise_configs {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  exercise_id uuid [not null, note: 'Polymorphic FK → exercises OR custom_exercises (see open-questions.md Q1)']
  working_weight_kg decimal(6,2) [not null]
  rep_range_lower int [not null]
  rep_range_upper int [not null]
  increment_kg decimal(5,2) [not null]
  trigger_rule trigger_rule_variant [not null]

  Indexes {
    (user_id, exercise_id) [unique, note: 'Also serves sync payload fetch']
  }
}

// ─── Workout Lifecycle ────────────────────────────────────────────────────

Table workouts {
  id uuid [pk, note: 'Client-generated for offline-safe creation']
  user_id uuid [not null, ref: > users.id]
  routine_id uuid [not null, ref: > routines.id]
  started_at_utc timestamptz [not null]
  completed_at_utc timestamptz
  idempotency_key uuid [not null, unique]

  Indexes {
    (user_id, completed_at_utc) [note: 'DESC — history feed; covers Streak math']
  }
}

Table sets {
  id uuid [pk, note: 'Client-generated for offline-safe writes']
  workout_id uuid [not null, ref: > workouts.id]
  user_id uuid [not null, ref: > users.id]
  exercise_id uuid [not null, note: 'Polymorphic FK → exercises OR custom_exercises (see open-questions.md Q1)']
  reps int [not null]
  weight_kg decimal(6,2) [not null]
  added_weight_kg decimal(6,2)
  bodyweight_snapshot_kg decimal(6,2)
  logged_at_utc timestamptz [not null]
  idempotency_key uuid [not null, unique]

  Indexes {
    (workout_id, logged_at_utc)
    (user_id, exercise_id, logged_at_utc) [note: 'DESC — per-Exercise history and PR calc']
  }
}

// ─── Bodyweight ───────────────────────────────────────────────────────────

Table weigh_ins {
  id uuid [pk, note: 'Client-generated for offline-safe writes']
  user_id uuid [not null, ref: > users.id]
  bodyweight_kg decimal(6,2) [not null]
  measured_at_utc timestamptz [not null]
  idempotency_key uuid [not null, unique]

  Indexes {
    (user_id, measured_at_utc) [note: 'DESC — latest-Weigh-in lookup']
  }
}

// ─── Progression Audit Log ────────────────────────────────────────────────

Table progression_events {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  exercise_id uuid [not null, note: 'Polymorphic FK → exercises OR custom_exercises (see open-questions.md Q1)']
  direction progression_direction [not null]
  before_kg decimal(6,2) [not null]
  after_kg decimal(6,2) [not null]
  workout_id uuid [not null, ref: > workouts.id]
  occurred_at_utc timestamptz [not null]

  Indexes {
    (user_id, exercise_id, occurred_at_utc) [note: 'DESC — Working Weight derivation and history']
  }
}

// ─── Notifications & FCM ──────────────────────────────────────────────────

Table notifications {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  kind notification_kind [not null]
  payload jsonb [not null]
  fcm_sent_at timestamptz
  created_at_utc timestamptz [not null, default: `now()`]
  read_at_utc timestamptz

  Indexes {
    (user_id, created_at_utc) [note: 'DESC — notification feed']
    user_id [name: 'notifications_unread_idx', note: 'Partial: WHERE read_at_utc IS NULL — unread count']
  }
}

Table fcm_tokens {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  token varchar [not null, unique]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id
  }

  Note: 'One user may hold multiple tokens (reinstalls, multi-device).'
}
